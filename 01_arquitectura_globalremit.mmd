    ORCH --> SETTLEMENT

    FX_PROVIDER --> QUOTE
    SETTLEMENT <--> BANK_NETWORK

    CUSTOMER --> OUTBOX
    REMITTANCE --> OUTBOX
    FX --> OUTBOX
    COMPLIANCE --> OUTBOX
    SETTLEMENT --> OUTBOX

    OUTBOX --> PUBLISHER
    PUBLISHER --> EVENTS
    PUBLISHER --> LIFECYCLE
    PUBLISHER --> RATES
    PUBLISHER --> FRAUD
    PUBLISHER --> CASES
    PUBLISHER --> SETTLEMENT_VIEW

    EVENTS --> OPS
    LIFECYCLE --> OPS
    LIFECYCLE --> ANALYTICS
    RATES --> ANALYTICS
    FRAUD --> RISK_USERS
    CASES --> RISK_USERS
    SETTLEMENT_VIEW --> OPS
    EVENTS --> AUDIT

    FRAUD -. "senal; decision final validada" .-> CHECKS

